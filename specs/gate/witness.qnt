/// Portable model witnesses; no trace here confers production evidence or authority.
module witness {
  import gate.* from "./model"

  action finishClaim(c: int): bool = finish({ manifest: manifest(c), attempt: s.attempt }, if (s.inputs.get(unit(c)) == 1) "fail" else "pass")
  action request(caller: str, stage: str, scope: str): bool = s' = s.with("caller", caller)
    .with("stage", stageFor(caller, stage)).with("scope", scope).with("snapshot", s.snapshot + 1)
  action policyOnly = s' = s.with("deferred", Set(0)).with("snapshot", s.snapshot + 1)
  action removeSharedSubject = s' = s.with("subjects", s.subjects.exclude(Set(1))).with("snapshot", s.snapshot + 1)
  action loseFacts = s' = s.with("facts", Set())
  action badHandoff = s' = s.with("context", false)
  action freshResult(c: int): bool = finish({ manifest: manifest(c), attempt: s.attempt }, "pass")
  run hooked = init.then(launch(7)).then(finishClaim(7))
  run prepared = hooked.then(structural).then(discover).then(plan)
  run covered = prepared
    .then(launch(0)).then(finishClaim(0))
    .then(launch(2)).then(finishClaim(2))
    .then(launch(4)).then(finishClaim(4))
    .then(launch(5)).then(finishClaim(5))
    .then(launch(6)).then(finishClaim(6))
  run admitted = covered.then(dropPending).then(discover).then(plan)
  run sealed = admitted.then(verify).then(review).then(validate)
  run violation = prepared.then(changeInput(0)).then(discover).then(plan)
    .then(launch(0)).then(finishClaim(0)).then(retainWitness(0)).then(confirm(0))
  run fixed = violation.then(campaign).then(changeInput(0)).then(launch(7)).then(finishClaim(7)).then(discover).then(plan)
    .then(launch(0)).then(finishClaim(0))

  run witnessSymbolicInitialReachabilityTest = init.then(s' = s.with("subjects", Set(0, 1)))
    .then(structural).then(discover).then(plan).then(launch(0)).then(finishClaim(0))
    .then(verify).then(review).then(validate).expect(s == smallInitial)
  run witnessPublicationTest = sealed.expect(s == sealedInitial).then(attemptPush).expect(s.accepted and s.published and not(s.alive) and safety)
  run witnessEarlyPushTest = prepared.then(attemptPush).expect(s.rejected and not(s.published))
  run witnessIncompleteBatchTest = covered.then(loseFacts).then(verify).then(attemptPush).expect(s.rejected)
  run witnessOutOfOrderTest = prepared.then(launch(0)).then(launch(2)).then(finishClaim(2)).then(finishClaim(0))
    .expect(coverage(0) == "pass" and coverage(2) == "pass" and safety)
  run witnessBuildNotResultTest = prepared.then(build(0)).expect(coverage(0) == "fresh-work-needed")
  run witnessSkipNotPassTest = prepared.then(launch(0)).then(finish({ manifest: manifest(0), attempt: s.attempt }, "skip"))
    .expect(coverage(0) == "fresh-work-needed")
  run witnessTimeoutNotCounterexampleTest = prepared.then(launch(0)).then(finish({ manifest: manifest(0), attempt: s.attempt }, "timeout"))
    .expect(not(blocked(0)) and coverage(0) == "fresh-work-needed")
  run witnessStaleCompletionTest = prepared.then(launch(0)).then(changeInput(0)).then(completion).then(discover).then(plan)
    .expect(coverage(0) == "fresh-work-needed" and safety)
  run witnessDuplicateAttemptTest = sealed.then(attemptPush).then(attemptPush).expect(s.rejected)
  run witnessChangedDuringValidationTest = sealed.then(changeInput(0)).then(attemptPush).expect(s.rejected)

  run referenceSharedDeferralTest = init.then(request("worker", "worker", "files"))
    .then(structural).then(discover).then(plan).then(launch(0)).then(finishClaim(0))
    .expect(coverage(0) == "pass" and coverage(1) == "not-required" and safety)
  run referenceFullTreeTest = init.then(request("standalone", "standing", "tree"))
    .then(structural).then(discover).then(plan).expect(eligible(1) and eligible(5) and not(eligible(7)) and safety)
  run referenceManualContextTest = hooked.then(request("manual", "worker", "diff"))
    .then(structural).then(discover).then(plan).expect(eligible(1) and not(eligible(5)) and s.stage == "publication" and safety)
  run referenceAllStagesTest = {
    nondet stage = Stages.oneOf()
    hooked.then(request("standalone", stage, "diff")).then(structural).then(discover).then(plan).expect(referenceEquivalence)
  }
  run referenceDeclarationOrderTest = prepared.expect(
    List(0, 1, 2, 3, 4, 5, 6, 7).foldl(Set(), (acc, c) => if (eligible(c)) acc.union(Set(c)) else acc) ==
    List(7, 6, 5, 4, 3, 2, 1, 0).foldl(Set(), (acc, c) => if (eligible(c)) acc.union(Set(c)) else acc))
  run referenceReadinessNotCriterionTest = prepared.then(launch(6)).then(finishClaim(6))
    .expect(coverage(6) == "UnneededPendingMarker" and coverage(2) == "fresh-work-needed" and safety)
  run referenceMalformedBarrierTest = hooked.then(malformed).then(structural).expect(not(s.structural) and s.launches == 1)
  run referenceCorrectedAdmissionTest = hooked.then(malformed).then(structural).then(correct).then(structural).then(discover).then(plan)
    .then(launch(0)).then(finishClaim(0)).expect(coverage(0) == "pass" and safety)
  run referenceProseEditTest = covered.then(claimEdit).expect(coverage(0) == "unavailable" and s.builds == Set())
  run referenceProseReadmissionTest = covered.then(claimEdit).then(correct).then(structural).then(discover).then(plan).then(reuse(0))
    .expect(coverage(0) == "pass" and s.launches == 6 and s.reuses == 1 and safety)

  run cacheIndependentReuseTest = covered.then(changeInput(1)).then(discover).then(plan).then(reuse(0))
    .expect(coverage(0) == "pass" and coverage(2) == "fresh-work-needed" and s.launches == 6 and safety)
  run cacheImportedResultTest = prepared.then(importResult(0, 0, true, true, true, true)).then(reuse(0))
    .expect(coverage(0) == "pass" and s.launches == 1 and safety)
  run cacheRejectedArtifactTest = {
    nondet flags = Set(Tup(1, true, true, true, true), Tup(0, false, true, true, true),
      Tup(0, true, false, true, true), Tup(0, true, true, false, true), Tup(0, true, true, true, false)).oneOf()
    prepared.then(importResult(0, flags._1, flags._2, flags._3, flags._4, flags._5))
      .expect(coverage(0) == "fresh-work-needed")
  }
  run cacheTrustReadmissionTest = prepared.then(importResult(0, 0, true, true, true, true)).then(trust)
    .expect(coverage(0) == "fresh-work-needed").then(trust).expect(coverage(0) == "pass")
  run cacheLiveImportNotFreshTest = prepared.then(importResult(4, 0, true, true, true, true)).expect(coverage(4) == "fresh-work-needed")
  run cacheDiagnosticBypassesResultTest = covered.then(diagnostic(0)).then(discover).then(plan)
    .then(launch(0)).then(finishClaim(0)).expect(coverage(0) == "pass" and s.launches == 7)
  run cacheDisagreementNotPermanentFailureTest = prepared.then(launch(4)).then(finishClaim(4))
    .then(diagnosticLaunch(4)).then(finish({ manifest: manifest(4), attempt: s.attempt }, "fail"))
    .expect(coverage(4) == "fail").then(diagnosticLaunch(4)).then(freshResult(4))
    .expect(coverage(4) == "pass" and disagreement(manifest(4)) and safety)
    .then(endAttempt(false)).then(retry).expect(coverage(4) == "fresh-work-needed" and disagreement(manifest(4)))
  run cacheFailedImportCannotResurrectTest = prepared.then(launch(4)).then(finish({ manifest: manifest(4), attempt: s.attempt }, "fail"))
    .then(importResult(4, 0, true, true, true, true)).expect(coverage(4) == "fail")
  run cacheEndedAttemptTest = sealed.then(endAttempt(false)).then(attemptPush).expect(s.rejected)
  run cacheUnknownRemoteRetryTest = sealed.then(endAttempt(true)).then(retry).then(attemptPush)
    .expect(s.remote == 1 and not(current) and s.rejected and coverage(0) == "pass" and coverage(4) == "fresh-work-needed")
  run cacheCheckoutDoesNotTransferAttemptTest = sealed.then(checkout).then(attemptPush).expect(s.rejected)
  run cacheRehearsalNoAuthorityTest = sealed.then(request("rehearsal", "worker", "diff"))
    .then(discover).then(plan).then(verify).then(review).then(validate).then(attemptPush).expect(s.rejected and eligible(1))
  run cacheMissingHandoffTest = sealed.then(badHandoff).then(attemptPush).expect(s.rejected)
  run cacheDeeperWitnessBlocksRoutineTest = violation.then(campaign).then(importResult(0, 0, true, true, true, true))
    .expect(blocked(0) and coverage(0) == "blocked")
  run cacheRoutinePassNotResolutionTest = fixed.expect(blocked(0) and coverage(0) == "blocked")
  run cacheReplayResolutionTest = fixed.then(replay(0)).then(resolve(0)).expect(not(blocked(0)) and coverage(0) == "pass" and safety)
  run cacheResolutionSurvivesCampaignOnlyChangeTest = fixed.then(replay(0)).then(resolve(0)).then(campaign)
    .then(launch(7)).then(finishClaim(7)).then(discover).then(plan).then(importResult(0, 0, true, true, true, true))
    .expect(not(blocked(0)) and coverage(0) == "pass" and safety)
  run cacheRelocationRetainsBlockerTest = violation.then(relocate).then(correct).then(structural).then(discover).then(plan)
    .expect(blocked(0) and coverage(0) == "blocked")
  run cacheMissingLinkTest = covered.then(loseLink).expect(coverage(0) == "unavailable")
  run cacheExpiryReindexRetainsWitnessTest = violation.then(consolidate).then(commitCheckpoint).then(deleteJournal).then(expire).then(rebuild)
    .expect(blocked(0) and not(s.logs) and s.index == events and coverage(0) == "blocked")
  run cacheRestartRetainsSharedCounterexampleTest = violation.then(consolidate).then(commitCheckpoint).then(deleteJournal)
    .then(expire).then(restart).then(recovery).then(checkout).then(retry)
    .expect(blocked(0) and coverage(0) == "blocked" and not(s.logs))
  run cacheRemoteAdvanceInvalidatesSealTest = sealed.then(remoteAdvance).then(attemptPush).expect(s.rejected)
  run cacheInterruptedRecoveryTest = covered.then(consolidate).then(commitCheckpoint).then(interruptedWrite)
    .expect(coverage(0) == "unavailable").then(recovery).expect(coverage(0) == "pass")
  run cacheMissingWitnessTest = violation.then(loseWitness).then(rebuild).expect(coverage(0) == "unavailable")
  run cacheCompactFactsNotPassTest = covered.then(consolidate).then(commitCheckpoint).then(deleteJournal).then(expire).then(loseFacts).then(rebuild)
    .expect(coverage(0) == "fresh-work-needed")
  run cacheConcurrentCheckoutsTest = prepared.then(launch(0)).then(finishClaim(0)).then(checkout)
    .then(launch(4)).then(finish({ manifest: manifest(4), attempt: s.attempt }, "fail")).then(consolidate).then(commitCheckpoint).then(checkout).then(rebuild)
    .expect(passed(manifest(0)) and failed(manifest(4)) and coverage(0) == "pass" and coverage(4) == "fail")
  run cacheValidationUseRaceTest = sealed.then(diagnosticLaunch(4)).then(finish({ manifest: manifest(4), attempt: s.attempt }, "fail")).then(attemptPush)
    .expect(s.rejected and coverage(4) == "fail")
  run cacheStaleEffectCompletionDoesNotChangeCurrentResultTest = prepared.then(launch(4))
    .then(changeInput(2)).then(changeInput(2)).then(discover).then(plan).then(launch(4)).then(finishClaim(4))
    .then({ nondet t = s.running.oneOf() finish(t, "fail") })
    .expect(coverage(4) == "pass" and safety)
  run cacheOldTaskCannotBecomeFreshTest = prepared.then(launch(4)).then(endAttempt(false)).then(retry)
    .then(finish({ manifest: manifest(4), attempt: s.attempt - 1 }, "pass")).expect(coverage(4) == "fresh-work-needed")
  run cacheManifestContextSeparationTest = prepared.then(importResult(0, 0, true, true, true, true))
    .then(trust).then(checkout).then(consolidate).then(commitCheckpoint).then(endAttempt(false)).then(retry).then(trust)
    .expect(coverage(0) == "pass" and s.facts.exists(f => f.manifest == manifest(0)))
  run cacheEnvironmentChangeTest = covered.then(changeEnvironment).then(launch(7)).then(finishClaim(7)).then(discover).then(plan)
    .expect(coverage(0) == "fresh-work-needed")
  run cacheDefinitionChangeTest = covered.then(definition(0)).then(discover).then(plan)
    .expect(Claims.exists(c => coverage(c) == "fresh-work-needed") and safety)
  run cacheCampaignChangeTest = covered.then(campaign).then(launch(7)).then(finishClaim(7)).then(discover).then(plan)
    .expect(coverage(0) == "fresh-work-needed")
  run cacheDiagnosticRequiresNewObservationTest = covered.then(diagnostic(0)).then(discover).then(plan)
    .expect(coverage(0) == "fresh-work-needed").then(launch(0)).then(finishClaim(0)).expect(coverage(0) == "pass")
  run referenceAbsentPendingDefinitionTest = prepared.then(absent(6)).then(discover).then(plan)
    .expect(coverage(6) == "not-required" and not(referenceRequired(6)) and safety)
  run referenceAbsentOrdinaryDefinitionTest = prepared.then(absent(0)).then(discover)
    .expect(not(current) and coverage(0) == "unavailable")
  run referenceMissingMembershipObservationTest = covered.then(removeSharedSubject).then(discover).then(plan)
    .expect(Claims.exists(c => s.subjects.contains(c) and coverage(c) == "fresh-work-needed") and safety)
  run referencePlanStageTest = hooked.then(request("standalone", "plan", "diff"))
    .then(structural).then(discover).then(plan).expect(eligible(5) and not(eligible(1)) and referenceEquivalence)
  run referenceWorkerStageTest = hooked.then(request("worker", "standing", "files"))
    .then(structural).then(discover).then(plan).expect(s.stage == "worker" and not(eligible(1)) and referenceEquivalence)
  run referenceIntegrationStageTest = hooked.then(request("integration", "standing", "diff"))
    .then(structural).then(discover).then(plan).expect(s.stage == "integration" and not(eligible(1)) and referenceEquivalence)
  run referenceStabilizationStageTest = hooked.then(request("standalone", "stabilization", "diff"))
    .then(structural).then(discover).then(plan).expect(not(eligible(5)) and not(eligible(1)) and referenceEquivalence)
  run referencePublicationStageTest = hooked.then(request("driver", "worker", "diff"))
    .then(structural).then(discover).then(plan).expect(s.stage == "publication" and eligible(1) and eligible(5) and referenceEquivalence)
  run referenceStandingStageTest = hooked.then(request("standalone", "standing", "tree"))
    .then(structural).then(discover).then(plan).expect(eligible(1) and eligible(5) and referenceEquivalence)
  run referencePolicyOnlyEditTest = covered.then(request("worker", "worker", "files"))
    .then(policyOnly).then(discover).then(plan).then(reuse(1))
    .expect(coverage(0) == "not-required" and coverage(1) == "pass" and s.launches == 6 and safety)
  run cacheReadinessImportIsNotFreshTest = prepared.then(importResult(6, 0, true, true, true, true))
    .expect(coverage(6) == "fresh-work-needed")
  run witnessLateBarrierLaunchRejectedTest = init.then(attemptLaunch(0)).expect(s.rejected and s.launches == 0)
  run witnessDeleteBeforeConsolidationRejectedTest = covered.then(attemptDeleteJournal)
    .expect(s.rejected and s.journal.length() == 6 and coverage(0) == "pass")
  run witnessResolvedCriteriaDispatchTest = init.then(assignCriteria(Set(0, 1))).then(dispatch)
    .expect(s.dispatched and not(s.rejected) and not(s.published))
  run witnessMalformedAcceptanceRepairTest = init.then(malformed).then(recordFinding)
    .then(assignRemediation(0)).then(dispatch).expect(s.dispatched and not(s.valid)).then(correct).expect(s.valid)
  run witnessOrdinaryReferencesCannotBecomeRepairTest = init.then(assignCriteria(Set(0, 99))).then(dispatch)
    .expect(s.rejected and not(s.dispatched) and s.goal == Unassigned)
  run witnessEmptyCriteriaCannotDispatchTest = init.then(assignCriteria(Set())).then(dispatch)
    .expect(s.rejected and not(s.dispatched))
  run witnessStaleCriterionAssignmentTest = init.then(assignCriteria(Set(0))).then(claimEdit).then(dispatch)
    .expect(s.rejected and not(s.dispatched))
  run witnessWorkerHistoryWritesRejectedTest = hooked.then(request("worker", "worker", "files")).then(enterWorker).then(attemptHistoryWrite)
    .expect(s.rejected and s.serial == 1 and s.journal.length() == 1 and s.historyAvailable)
  run witnessHookModificationTest = init.then(launch(7)).then(finish({ manifest: manifest(7), attempt: s.attempt }, "modified"))
    .then(structural).expect(not(s.structural) and s.rejected)
  run witnessMissingHookToolTest = init.then(launch(7)).then(finish({ manifest: manifest(7), attempt: s.attempt }, "unavailable"))
    .then(structural).expect(not(s.structural) and s.rejected)
  run witnessHookBeforeAnnotationsTest = init.then(structural).expect(not(s.structural) and s.launches == 0)
  run witnessNestedHookNoAuthorityTest = init.then(s' = s.with("parent", true).with("scope", "files"))
    .then(structural).then(discover).then(attemptPush).expect(not(current) and s.rejected and s.launches == 0)
  run witnessManualPublicationTest = admitted.then(request("manual", "worker", "diff"))
    .then(discover).then(plan).then(verify).then(validate).then(attemptPush).expect(s.accepted and safety)
  run witnessWorkerFeedbackTest = init.then(request("worker", "worker", "files")).then(structural).then(discover).then(plan)
    .then(launch(0)).then(finishClaim(0)).then(launch(2)).then(finishClaim(2))
    .then(launch(4)).then(finishClaim(4)).then(launch(6)).then(finishClaim(6)).then(verify)
    .expect(s.verified == -1 and coverage(6) == "UnneededPendingMarker")
    .then(dropPending).then(discover).then(plan).then(verify)
    .expect(s.verified == s.snapshot).then(attemptPush).expect(s.rejected and not(s.published))
  run witnessNoReuseStillPublishesTest = admitted.then(loseFacts).then(launch(7)).then(finishClaim(7))
    .then(launch(0)).then(finishClaim(0)).then(launch(2)).then(finishClaim(2))
    .then(launch(4)).then(finishClaim(4)).then(launch(5)).then(finishClaim(5))
    .then(verify).then(review).then(validate).then(attemptPush).expect(s.accepted and s.launches == 11 and safety)

  run referenceNativeTestReadinessIsStructuralTest = hooked.then(toggleNativePending(2)).then(structural)
    .then(attemptLaunch(2)).expect(not(s.structural) and s.rejected and s.launches == 1)
  run referenceJudgeReadinessIsStructuralTest = hooked.then(toggleNativePending(5)).then(structural)
    .then(attemptLaunch(5)).expect(not(s.structural) and s.rejected and s.launches == 1)
  run referenceAbsentNativeTestRemainsPendingTest = hooked.then(absent(2)).then(toggleNativePending(2))
    .then(structural).then(discover).then(plan).expect(current and coverage(2) == "not-required" and s.launches == 1 and safety)
  run referenceAbsentJudgeRemainsPendingTest = hooked.then(absent(5)).then(toggleNativePending(5))
    .then(structural).then(discover).then(plan).expect(current and coverage(5) == "not-required" and s.launches == 1 and safety)
  run referencePassingReadinessBlocksPublicationTest = covered.then(verify).then(review).then(validate).then(attemptPush)
    .expect(coverage(6) == "UnneededPendingMarker" and not(complete) and s.rejected and safety)
  run referenceFailingReadinessRemainsPendingTest = prepared.then(changeInput(1)).then(discover).then(plan)
    .then(launch(6)).then(finishClaim(6))
    .expect(coverage(6) == "pending" and coverage(2) == "fresh-work-needed" and safety)
  run referenceProspectiveReadinessAllowsPublicationTest = init
    .then(s' = s.with("subjects", Set(0, 1, 4, 5, 6, 7))).then(changeInput(1))
    .then(launch(7)).then(finishClaim(7)).then(structural).then(discover).then(plan)
    .then(launch(0)).then(finishClaim(0)).then(launch(4)).then(finishClaim(4))
    .then(launch(5)).then(finishClaim(5)).then(launch(6)).then(finishClaim(6))
    .expect(coverage(6) == "pending" and complete).then(verify).then(review).then(validate).then(attemptPush)
    .expect(s.accepted and safety)
  run referenceIncompleteReadinessCannotCompleteTest = {
    nondet outcome = Set("skip", "timeout", "unavailable").oneOf()
    prepared.then(launch(6)).then(finish({ manifest: manifest(6), attempt: s.attempt }, outcome))
      .then(verify).expect(coverage(6) == "fresh-work-needed" and s.verified == -1 and safety)
  }
  run referenceMarkerRemovalDoesNotPromoteReadinessTest = prepared.then(launch(6)).then(finishClaim(6))
    .then(dropPending).then(discover).then(plan)
    .expect(coverage(6) == "fresh-work-needed" and coverage(2) == "fresh-work-needed" and safety)
    .then(launch(2)).then(finishClaim(2)).expect(coverage(6) == "pass" and s.launches == 3 and safety)
  run referenceMarkerRemovalPreservesIndependentExecutionTest = admitted
    .expect(coverage(6) == "pass" and s.launches == 6 and safety)
  run referenceResourceOmissionDetectedTest = prepared.expect(Claims.forall(c =>
    constructionAgrees(c, manifest(c)) and not(constructionAgrees(c,
      manifest(c).with("resources", manifest(c).resources.exclude(Set(8 + unit(c))))))))
  run referenceSubjectResponsibilityOmissionDetectedTest = prepared.expect(Claims.forall(c =>
    not(constructionAgrees(c, manifest(c).with("members", manifest(c).members.exclude(Set(c)))))))
  run referenceWrongUnitDetectedTest = prepared.expect(Claims.forall(c =>
    not(constructionAgrees(c, manifest(c).with("unit", (unit(c) + 1) % 5)))))
  run referenceInventoryOmissionCannotLaunchTest = prepared.then(s' = s.with("inventory", s.inventory.exclude(Set(0))))
    .then(attemptLaunch(0)).then(attemptPush).expect(s.rejected and s.launches == 1 and not(current))
  run cacheStagedCheckpointCannotPermitDeletionTest = covered.then(consolidate).then(attemptDeleteJournal)
    .expect(s.rejected and s.checkpoint == Set() and s.journal.length() == 6 and safety)
  run cacheStagedCheckpointRestartRetainsJournalTest = violation.then(consolidate).then(restart).then(recovery)
    .expect(not(s.checkpointStaged) and s.checkpoint == Set() and blocked(0) and history(0) and safety)
  run cacheCheckpointConcurrentAppendCannotBeDeletedTest = prepared.then(launch(0)).then(finishClaim(0)).then(consolidate)
    .then(checkout).then(launch(4)).then(finish({ manifest: manifest(4), attempt: s.attempt }, "fail"))
    .then(commitCheckpoint).then(attemptDeleteJournal)
    .expect(s.rejected and failed(manifest(4)) and s.journal.length() == 3 and safety)
    .then(consolidate).then(commitCheckpoint).then(deleteJournal).then(restart).then(recovery)
    .expect(failed(manifest(4)) and passed(manifest(0)) and s.journal == List() and safety)
  run cacheConfirmationRequiresDurableWitnessTest = prepared.then(changeInput(0)).then(discover).then(plan)
    .then(launch(0)).then(finishClaim(0))
    .then(confirm(0)).expect(s.rejected and not(blocked(0)) and s.objects == Set())
    .then(retainWitness(0)).expect(not(blocked(0)))
    .then(confirm(0)).then(restart).then(recovery).expect(blocked(0) and history(0) and safety)
  run cacheWitnessAttributionCannotConfirmSiblingTest = prepared.then(changeInput(0)).then(discover).then(plan)
    .then(launch(0)).then(finishClaim(0)).then(retainWitness(0))
    .then(confirm(1)).expect(s.rejected and not(blocked(1)))
  run workerProtected = violation.then(consolidate).then(enterWorker)
  val workerHistoryPreserved = s.rejected and s.journal.length() == 3 and s.objects.size() == 1 and
    s.checkpoint == Set() and s.checkpointStaged and blocked(0) and history(0)
  run cacheWorkerRetainWitnessRejectedTest = workerProtected.then(retainWitness(0)).expect(workerHistoryPreserved)
  run cacheWorkerConfirmationRejectedTest = workerProtected.then(confirm(0)).expect(workerHistoryPreserved)
  run cacheWorkerReplayRejectedTest = workerProtected.then(replay(0)).expect(workerHistoryPreserved)
  run cacheWorkerResolutionRejectedTest = workerProtected.then(resolve(0)).expect(workerHistoryPreserved)
  run cacheWorkerCheckpointStagingRejectedTest = workerProtected.then(consolidate).expect(workerHistoryPreserved)
  run cacheWorkerCheckpointCommitRejectedTest = workerProtected.then(commitCheckpoint).expect(workerHistoryPreserved)
  run cacheWorkerJournalDeletionRejectedTest = workerProtected.then(deleteJournal).expect(workerHistoryPreserved)
  run cacheWorkerRecoveryRejectedTest = workerProtected.then(recovery).expect(workerHistoryPreserved)
  run cacheWorkerAssociationForgeryRejectedTest = workerProtected.then(checkout).expect(workerHistoryPreserved)
  run cacheWorkerCanonicalMutatorsRejectedTest = workerProtected.then(attemptHistoryWrite).expect(workerHistoryPreserved)
  run cacheWorkerCompletionCannotAppendCanonicalHistoryTest = prepared.then(launch(4)).then(enterWorker)
    .then(finish({ manifest: manifest(4), attempt: s.attempt }, "fail"))
    .expect(not(failed(manifest(4))) and s.journal.length() == 1 and s.facts.exists(f => f.outcome == "fail"))
  run cacheWorkerImportCannotAppendCanonicalHistoryTest = prepared.then(enterWorker)
    .then(importResult(0, 0, true, true, true, true)).expect(s.journal.length() == 1 and not(passed(manifest(0))))
  run cacheMissingHistoryCannotRecoverAsEmptyTest = violation.then(loseHistory).then(restart).then(recovery)
    .then(importResult(0, 0, true, true, true, true)).then(verify).then(attemptPush)
    .expect(not(s.historyAvailable) and coverage(0) == "unavailable" and s.rejected and s.verified == -1 and safety)
}
