#!/usr/bin/env bash
set -euo pipefail
umask 077
if [[ -n "${LOOM_INSIDE:-}" || -n "${NIX_BUILD_TOP:-}" || $(uname -s) != Linux ]]; then
  printf 'Native lifetime conformance requires the Linux host with delegated cgroup2.\n' >&2
  exit 1
fi
bash scripts/configure-cargo-patches.sh
cargo nextest run -p loom-driver --run-ignored only --ignore-default-filter \
  -E 'test(native_cargo_lifetime_seals_empty_generation_and_cancels_stale_entry) | test(native_cargo_retention_restart_reconciles_owned_process_generations)'
