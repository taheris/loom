#!/usr/bin/env bash
set -euo pipefail
umask 077

if [[ -n "${LOOM_INSIDE:-}" ]]; then
  printf 'Actual Wrix projection conformance requires the Linux host.\n' >&2
  exit 1
fi

if [[ -z "${LOOM_CONFORMANCE_WRIX:-}" || -z "${LOOM_CONFORMANCE_PROFILE:-}" ]]; then
  if [[ -z "${LOOM_PROFILES_MANIFEST:-}" ]]; then
    printf 'Select LOOM_PROFILES_MANIFEST or both LOOM_CONFORMANCE_WRIX and LOOM_CONFORMANCE_PROFILE.\n' >&2
    exit 1
  fi
  LOOM_CONFORMANCE_WRIX=${LOOM_CONFORMANCE_WRIX:-$(jq -er '.rust.pi.launcher' "$LOOM_PROFILES_MANIFEST")}
  LOOM_CONFORMANCE_PROFILE=${LOOM_CONFORMANCE_PROFILE:-$(jq -er '.rust.pi.profile_config' "$LOOM_PROFILES_MANIFEST")}
fi
export LOOM_CONFORMANCE_WRIX LOOM_CONFORMANCE_PROFILE
# A fresh host control plane uses the existing explicit standalone admission;
# never acknowledge or mutate the operator's live Wrix state or service roots.
control=$(mktemp -d /tmp/loom-wrix-conformance.XXXXXXXX)
export XDG_STATE_HOME="$control/state" XDG_CACHE_HOME="$control/cache"
export XDG_DATA_HOME="$control/data" XDG_CONFIG_HOME="$control/config"
printf 'Wrix conformance control state: %s\n' "$control"
"$LOOM_CONFORMANCE_WRIX" workspace initialize
"$LOOM_CONFORMANCE_WRIX" workspace acknowledge-scope --version 1
# Runtime evidence must survive an enclosing disposable native-fixture runner.
export TMPDIR=/tmp
bash scripts/configure-cargo-patches.sh
cargo nextest run -p loom-driver --run-ignored only --ignore-default-filter \
  -E 'test(wrix_cargo_storage_projection_matches_admitted_profile)'
