+    #[cfg(target_os = "linux")]
+    #[test]
+    fn capture_closes_while_unrelated_sibling_is_paused_before_exec() {
+        use std::os::unix::process::CommandExt;
+        use std::time::Instant;
+
+        const CONTROL: &str = "NEXTEST_CAPTURE_HANDOFF_CONTROL";
+        const TEST: &str = "test_command::imp::tests::capture_closes_while_unrelated_sibling_is_paused_before_exec";
+        if std::env::var_os(CONTROL).is_some() {
+            capture_handoff_control();
+            return;
+        }
+
+        let directory = camino_tempfile::tempdir().unwrap();
+        let log_path = directory.path().join("control.log");
+        let log = std::fs::File::create(&log_path).unwrap();
+        let mut child = Command::new(std::env::current_exe().unwrap())
+            .args(["--exact", TEST, "--nocapture"])
+            .env(CONTROL, "1")
+            .stdout(log.try_clone().unwrap())
+            .stderr(log)
+            .process_group(0)
+            .spawn()
+            .unwrap();
+        let deadline = Instant::now() + Duration::from_secs(10);
+        let status = loop {
+            if let Some(status) = child.try_wait().unwrap() {
+                break Some(status);
+            }
+            if Instant::now() >= deadline {
+                unsafe {
+                    libc::kill(-(child.id() as i32), libc::SIGKILL);
+                }
+                child.wait().unwrap();
+                break None;
+            }
+            thread::sleep(Duration::from_millis(1));
+        };
+        if !status.is_some_and(|status| status.success()) {
+            // Reap pre-exec descendants as well if the control exited on a panic.
+            unsafe {
+                libc::kill(-(child.id() as i32), libc::SIGKILL);
+            }
+        }
+        assert!(
+            status.is_some_and(|status| status.success()),
+            "capture handoff control failed or exceeded its startup/cleanup watchdog: {:?}\n{}",
+            status,
+            std::fs::read_to_string(log_path).unwrap(),
+        );
+    }
+
+    #[cfg(target_os = "linux")]
+    fn capture_handoff_control() {
+        use std::io::Read;
+        use std::os::fd::AsRawFd;
+        use std::os::unix::process::CommandExt;
+
+        let runtime = tokio::runtime::Runtime::new().unwrap();
+        let (mut first_ready_rx, first_ready_tx) = std::io::pipe().unwrap();
+        let (first_release_rx, first_release_tx) = std::io::pipe().unwrap();
+        let (mut peer_ready_rx, peer_ready_tx) = std::io::pipe().unwrap();
+        let (peer_release_rx, peer_release_tx) = std::io::pipe().unwrap();
+        let configure = |ready: i32, release: i32| {
+            let mut cmd = Command::new("sh");
+            cmd.args(["-c", "printf capture-marker"]);
+            unsafe {
+                cmd.pre_exec(move || {
+                    let byte = [1u8];
+                    if libc::write(ready, byte.as_ptr().cast(), 1) != 1 {
+                        return Err(io::Error::last_os_error());
+                    }
+                    let mut token = [0u8];
+                    if libc::read(release, token.as_mut_ptr().cast(), 1) != 1 {
+                        return Err(io::Error::last_os_error());
+                    }
+                    Ok(())
+                });
+            }
+            cmd
+        };
+        let first_cmd = configure(first_ready_tx.as_raw_fd(), first_release_rx.as_raw_fd());
+        let peer_cmd = configure(peer_ready_tx.as_raw_fd(), peer_release_rx.as_raw_fd());
+        let closed = thread::scope(|scope| {
+            let first = scope.spawn(|| {
+                let _guard = runtime.enter();
+                spawn(first_cmd, CaptureStrategy::Split, false)
+            });
+            first_ready_rx.read_exact(&mut [0]).unwrap();
+            let peer = scope.spawn(|| {
+                let _guard = runtime.enter();
+                spawn(peer_cmd, CaptureStrategy::Split, false)
+            });
+            // Release even when the lease correctly prevents peer startup.
+            let release = scope.spawn(|| {
+                thread::sleep(Duration::from_millis(100));
+                assert_eq!(
+                    unsafe { libc::write(first_release_tx.as_raw_fd(), [1u8].as_ptr().cast(), 1) },
+                    1
+                );
+            });
+            peer_ready_rx.read_exact(&mut [0]).unwrap();
+            let mut first = first.join().unwrap().unwrap();
+            runtime.block_on(first.child.wait()).unwrap();
+            let mut accumulator = ChildAccumulator::new(first.child_fds);
+            let closed = runtime.block_on(async {
+                tokio::time::timeout(Duration::from_millis(200), async {
+                    while !accumulator.fds.is_done() {
+                        accumulator.fill_buf().await;
+                    }
+                })
+                .await
+                .is_ok()
+            });
+            assert_eq!(
+                unsafe { libc::write(peer_release_tx.as_raw_fd(), [1u8].as_ptr().cast(), 1) },
+                1
+            );
+            let mut peer = peer.join().unwrap().unwrap();
+            runtime.block_on(peer.child.wait()).unwrap();
+            release.join().unwrap();
+            closed
+        });
+        assert!(
+            closed,
+            "unrelated pre-exec sibling retained the exited child's capture writers"
+        );
+    }
