+#[cfg(test)]
+mod storage_options_tests {
+    use super::linux_store_spec;
+
+    #[test]
+    fn explicit_store_keeps_actual_driver_options() {
+        let info = br#"{"store":{"graphDriverName":"overlay","graphRoot":"/tmp/graph","runRoot":"/tmp/run","graphOptions":{"overlay.ignore_chown_errors":"true","overlay.mount_program":{"Executable":"/nix/store/helper/bin/fuse-overlayfs","Version":"metadata"}}}}"#;
+        assert_eq!(
+            linux_store_spec(info).as_deref(),
+            Some(
+                "overlay@/tmp/graph+/tmp/run:overlay.ignore_chown_errors=true,overlay.mount_program=/nix/store/helper/bin/fuse-overlayfs"
+            )
+        );
+    }
+
+    #[test]
+    fn malformed_driver_options_do_not_invent_a_store_spec() {
+        assert!(linux_store_spec(br#"{"store":{"graphDriverName":"overlay","graphRoot":"/tmp/graph","runRoot":"/tmp/run","graphOptions":{"overlay.mount_program":{"Version":"unknown"}}}}"#).is_none());
+    }
