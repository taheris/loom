+fn linux_store_spec(bytes: &[u8]) -> Option<String> {
+    let Ok(info) = serde_json::from_slice::<Value>(bytes) else {
+        return None;
+    };
+    let store = info.get("store")?;
+    let driver = store.get("graphDriverName")?.as_str()?;
+    let graph = store.get("graphRoot")?.as_str()?;
+    let run = store.get("runRoot")?.as_str()?;
+    let mut options = Vec::new();
+    if let Some(values) = store.get("graphOptions").and_then(Value::as_object) {
+        for (key, value) in values {
+            let value = match value {
+                Value::String(value) => value.clone(),
+                Value::Bool(value) => value.to_string(),
+                Value::Number(value) => value.to_string(),
+                Value::Object(value) => value.get("Executable")?.as_str()?.to_owned(),
+                _ => return None,
+            };
+            if key.contains([',', ':', ']', '\n']) || value.contains([',', ':', ']', '\n']) {
+                return None;
+            }
+            options.push(format!("{key}={value}"));
+        }
+    }
+    if [driver, graph, run]
+        .iter()
+        .any(|part| part.is_empty() || part.contains(['@', '+', ':', ']', '\n']))
+    {
+        return None;
+    }
+    let suffix = if options.is_empty() {
+        String::new()
+    } else {
+        format!(":{}", options.join(","))
+    };
+    Some(format!("{driver}@{graph}+{run}{suffix}"))
+}
